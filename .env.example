# OpenAI API キー(https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# MFlux バックエンド(olmx を起動している PC 上の OpenAI 互換サーバー)
# 例: http://192.168.x.x:8080/v1
MFLUX_BASE_URL=
# 任意: mflux サーバー側のモデル名(未設定ならカタログ ID "mflux" をそのまま送信)
MFLUX_MODEL=

# プロンプト調整(「ローカルLLMでプロンプトを調整」チェック)に使うローカルLLM(OpenAI 互換)
# 既定はこの VM で pi が使う oxlm(192.168.68.56:8888)。必要なら書き換える
LOCAL_LLM_BASE_URL=http://192.168.68.56:8888/v1
# 任意: 調整に使うモデル名(未設定なら gemma-4-31b-it-4bit)
LOCAL_LLM_MODEL=gemma-4-31b-it-4bit
# 任意: 認証キー。未設定なら環境変数 OXLM_API_KEY を共用する(モデル解放にも使う)
LOCAL_LLM_API_KEY=

# 動画生成(MiniMax H3)。LAN の Mac mini で動く ComfyUI の HTTP API
H3_BASE_URL=http://192.168.68.56:8188
# 任意: 使うグラフ(API 形式の skeleton)。未設定ならリポジトリの h3/skeleton.json
H3_SKELETON_PATH=
